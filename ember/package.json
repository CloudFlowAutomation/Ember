{
  "name": "Ember",
  "productName": "Ember",
  "version": "0.9.0",
  "description": "Ember - Secure Chat the fizzles away. End-to-end encrypted group chat with perfect forward secrecy.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e-sim.js",
    "make": "electron-forge make --platform=darwin --arch=universal",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "make:all": "npm run make && npm run make:win && npm run make:linux",
    "publish": "electron-forge publish --platform=darwin --arch=universal",
    "publish:win": "electron-forge publish --platform=win32 --arch=x64",
    "publish:linux": "electron-forge publish --platform=linux --arch=x64",
    "publish:all": "npm run publish && npm run publish:win && npm run publish:linux",
    "bundle:mlkem": "npx --yes esbuild@0.25.5 --bundle --format=iife --global-name=MlKemBundle --minify --outfile=renderer/vendor/mlkem.js node_modules/mlkem/esm/mod.js"
  },
  "license": "MIT",
  "dependencies": {
    "mlkem": "^2.7.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "electron": "^43.2.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  }
}
